# Copy to .env and fill in. Every variable is validated at startup by src/server/env.ts.
# Every external service has a development driver (default) and a real one; the real one needs
# its keys. Going live, step by step: docs/deployment.md.

# Where the app runs: local | test | staging | production
APP_ENV=local

# Local PostgreSQL started by scripts/with-db.mjs (no Docker needed)
DATABASE_URL=postgresql://postgres:postgres@localhost:5444/eduprep
# Connections per process (app and worker each). Raise for heavy traffic (load test: D-065).
# DATABASE_POOL_SIZE=10

# Random secret, at least 32 characters, used to sign session cookies and hash sign-in codes.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Sign-in (D-043). "dev" adds the /dev-login test-account picker next to real email and phone
# sign-in; "live" is real sign-in only (required in production).
AUTH_MODE=dev

# Local testing only. "true" = no sign-in codes (sign-up signs you straight in, phone OTP is
# hidden) and no payments (everything unlocked, pricing hidden, interviews book for free).
# Refused in production.
TEST_MODE=false

# Brand (D-021): change these to rename the product
NEXT_PUBLIC_APP_NAME=AnyPrep
# Production: https://anyprep.in (D-068)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Code judge (D-033). "local" runs code with this machine's compilers: development and tests
# only, refused when APP_ENV=production. Needs gcc/g++, a JDK, Python 3 and Node.
JUDGE_DRIVER=local
# Optional overrides for the local judge:
# JUDGE_GCC=gcc
# JUDGE_GPP=g++
# JUDGE_PYTHON=python
# JUDGE_JAVA_HOME=C:\Program Files\Java\jdk-22
# Production: JUDGE_DRIVER=judge0 and your Judge0 server.
# JUDGE0_URL=https://judge0.example.com
# JUDGE0_TOKEN=

# Payments (D-040, D-044). "mock" = test checkout page with signed webhooks (refused in
# production). "razorpay" needs the three keys below (test keys start with rzp_test_).
PAYMENT_DRIVER=mock
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Meetings (D-041). "mock" = local meeting room page; "google" = Calendar event with a Meet link.
MEETING_DRIVER=mock
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_CALENDAR_OWNER=interviews@yourdomain.com
# GOOGLE_CALENDAR_ID=primary

# Messages (D-041, D-045). "outbox" keeps every message in admin › Notifications (emails also as
# HTML files in .data/mail; MAIL_DIR overrides) and sends nothing out.
EMAIL_DRIVER=outbox
# RESEND_API_KEY=re_...
# EMAIL_FROM="EduPrep <no-reply@yourdomain.com>"
SMS_DRIVER=outbox
# MSG91_AUTH_KEY=
# MSG91_OTP_TEMPLATE_ID=
WHATSAPP_DRIVER=outbox
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE=account_update

# Public-page rate limit (D-058): how many public proxies sit in front of the app and append to
# X-Forwarded-For (1 = just the host; 2 = a CDN such as Cloudflare in front of the host).
# TRUSTED_PROXY_HOPS=1

# Background jobs (D-029, D-046). "postgres" = workers poll the jobs table; "bullmq" = Redis
# delivers jobs instantly (the table stays the record).
QUEUE_DRIVER=postgres
# REDIS_URL=redis://localhost:6379
# WORKER_CONCURRENCY=4

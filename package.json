{
  "name": "eduprep",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/with-db.mjs concurrently -k -n web,worker -c blue,magenta \"next dev\" \"npm run worker\"",
    "build": "next build",
    "start": "next start",
    "worker": "tsx --conditions=react-server src/worker/index.ts",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node scripts/with-db.mjs \"vitest run --config vitest.integration.config.mts\"",
    "test:e2e": "playwright test",
    "test:load": "node scripts/with-db.mjs \"vitest run --config vitest.load.config.mjs --silent=false\"",
    "check": "npm run lint && npm run typecheck && npm run test && node scripts/check-brand.mjs",
    "db:start": "node scripts/with-db.mjs",
    "db:stop": "node scripts/db-stop.mjs",
    "db:migrate": "node scripts/with-db.mjs prisma migrate dev",
    "db:deploy": "node scripts/with-db.mjs prisma migrate deploy",
    "db:seed": "node scripts/with-db.mjs prisma db seed",
    "db:reset": "node scripts/with-db.mjs prisma migrate reset",
    "db:studio": "node scripts/with-db.mjs prisma studio",
    "content:sample": "node scripts/with-db.mjs tsx --conditions=react-server scripts/load-sample-content.ts",
    "content:import": "node scripts/with-db.mjs tsx --conditions=react-server scripts/import-folder.ts",
    "postinstall": "prisma generate",
    "prepare": "husky"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@uiw/react-codemirror": "^4.25.12",
    "bullmq": "^5.81.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "dotenv": "^18.0.8",
    "fflate": "^0.8.3",
    "ioredis": "^5.11.1",
    "jose": "^6.2.12",
    "katex": "^0.19.0",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "read-excel-file": "^9.3.12",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "embedded-postgres": "^17.10.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "katex": "$katex"
  }
}
